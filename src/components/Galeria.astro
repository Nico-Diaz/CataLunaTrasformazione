---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CarruselTrabajos from './CarruselTrabajos';
import { clientas } from '../data/sitio';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/clientas/*.jpg', { eager: true });
const fotoDe = (nombre: string) => {
  const f = fotos[`../assets/clientas/${nombre}.jpg`];
  if (!f) throw new Error(`Falta la foto src/assets/clientas/${nombre}.jpg`);
  return f.default;
};

// Versiones livianas (WebP, 900 px) para las texturas del carrusel.
const items = await Promise.all(
  clientas.map(async (c) => {
    const img = await getImage({ src: fotoDe(c.foto), width: 900, format: 'webp', quality: 80 });
    return { image: img.src, text: c.nombre, alt: `${c.nombre}, clienta, con su prenda a medida` };
  }),
);
---

<section id="trabajos" class="galeria sobre-noche" aria-labelledby="galeria-titulo">
  <div class="container galeria__head">
    <div>
      <p class="label" data-aparece>Clientas</p>
      <h2 id="galeria-titulo" data-titulo>Lo convertimos juntas.</h2>
    </div>
    <p class="galeria__texto" data-aparece>
      Cada prenda empezó con una idea y una cita. Arrastrá para recorrerlas y tocá una para verla de cerca.
    </p>
  </div>

  <div class="galeria__escena" data-aparece>
    <CarruselTrabajos client:visible items={items} />
  </div>

  <div class="container galeria__pie" data-aparece>
    <p>¿La próxima es la tuya?</p>
    <a class="btn btn--solido" href="#idea" data-magnetico>Contame tu idea</a>
  </div>
</section>

<style>
  .galeria {
    padding-block: clamp(4.5rem, 10vw, 7.5rem) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }

  .galeria__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  .galeria__head .label {
    color: var(--suave-sobre-noche);
    margin-bottom: 1rem;
  }

  .galeria__head h2 {
    font-size: clamp(2.25rem, 5vw, 4.25rem);
  }

  .galeria__texto {
    color: var(--suave-sobre-noche);
    max-width: 38ch;
  }

  .galeria__escena {
    height: clamp(26rem, 72vh, 46rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .galeria__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 1rem;
    text-align: center;
  }

  .galeria__pie p {
    font-family: var(--font-titulo);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (max-width: 760px) {
    .galeria__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .galeria__escena {
      height: clamp(24rem, 62vh, 32rem);
    }
  }
</style>

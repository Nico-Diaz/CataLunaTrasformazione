---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo-crema.png';
import { contacto } from '../data/sitio';
import { urlWhatsApp } from '../lib/whatsapp';
const anio = new Date().getFullYear();
---

<footer class="pie sobre-noche">
  <div class="container pie__inner">
    <Image class="pie__logo" src={logo} alt="Catalina Luna" widths={[160, 320]} sizes="160px" />

    <div class="pie__col">
      <p class="label">Contacto</p>
      <a href={urlWhatsApp()} target="_blank" rel="noopener">WhatsApp {contacto.whatsappVisible}</a>
      <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
      {contacto.instagram && <a href={contacto.instagram} target="_blank" rel="noopener">Instagram</a>}
    </div>

    <div class="pie__col">
      <p class="label">Horario de consultas</p>
      <p>{contacto.horarioConsultas}</p>
      <p>{contacto.ciudad}</p>
    </div>
  </div>
  <div class="container pie__legal">
    <p>© {anio} {contacto.nombre} · {contacto.titulo} · {contacto.matricula}</p>
    <p class="pie__extra">
      <a class="pie__firma" href="https://www.bynico.tech" target="_blank" rel="noopener">
        Hecho por <strong>bynico.tech</strong>
      </a>
      <span aria-hidden="true">·</span>
      <a class="pie__firma" href="/admin" rel="nofollow">Panel</a>
    </p>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
  }

  .pie__inner {
    display: grid;
    grid-template-columns: auto repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .pie :global(.pie__logo) {
    width: 9rem;
  }

  .pie__col {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .pie__col .label {
    color: var(--suave-sobre-noche);
    margin-bottom: 0.35rem;
  }

  .pie__col a {
    text-decoration: none;
  }

  .pie__col a:hover {
    text-decoration: underline;
  }

  .pie__legal {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea-sobre-noche);
    color: var(--suave-sobre-noche);
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
  }

  .pie__extra {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.75rem;
  }

  .pie__extra > span {
    opacity: 0.4;
  }

  .pie__firma {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: inherit;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .pie__firma strong {
    font-weight: 600;
  }

  .pie__firma:hover,
  .pie__firma:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .pie__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import { Image } from 'astro:assets';
import etiqueta from '../assets/marca/trasformazione-etiqueta.jpg';
import conjunto from '../assets/trabajos/conjunto-negro.jpg';
import { trasformazione } from '../data/sitio';
---

<section id="trasformazione" class="seccion sobre-noche trasf" aria-labelledby="trasf-titulo">
  <div class="container trasf__inner">
    <div class="trasf__texto">
      <p class="label" data-aparece>Otra línea, el mismo oficio</p>
      <h2 id="trasf-titulo" data-titulo>{trasformazione.nombre}</h2>
      <p class="trasf__bajada" data-aparece>{trasformazione.bajada}</p>
      {trasformazione.parrafos.map((p) => <p class="trasf__p" data-aparece>{p}</p>)}
      <ul class="trasf__ejemplos" data-aparece>
        {trasformazione.ejemplos.map((e) => <li>{e}</li>)}
      </ul>
      <a class="btn btn--solido" href="#idea" data-linea="Trasformazione" data-magnetico>Consultar por Trasformazione</a>
    </div>

    <div class="trasf__fotos">
      <div class="trasf__foto trasf__foto--a" data-revela>
        <Image
          src={etiqueta}
          alt="Etiqueta colgante con el logo de Trasformazione"
          widths={[300, 450, 600]}
          sizes="(max-width: 860px) 45vw, 280px"
        />
      </div>
      <div class="trasf__foto trasf__foto--b" data-revela>
        <Image
          src={conjunto}
          alt="Clienta al sol con conjunto negro de top asimétrico y falda corta"
          widths={[300, 450, 600]}
          sizes="(max-width: 860px) 45vw, 280px"
          data-parallax="5"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { elegir } from '../lib/eleccion';
  document.querySelectorAll<HTMLAnchorElement>('a[data-linea]').forEach((a) => {
    a.addEventListener('click', () => elegir({ linea: a.dataset.linea as 'Trasformazione' }));
  });
</script>

<style>
  .trasf__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .trasf__texto {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .trasf__texto .label {
    color: var(--suave-sobre-noche);
  }

  .trasf__bajada {
    font-family: var(--font-sub);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .trasf__p {
    color: var(--suave-sobre-noche);
    max-width: 52ch;
  }

  .trasf__ejemplos {
    list-style: none;
    margin: 0.25rem 0 0.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .trasf__ejemplos li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--linea-sobre-noche);
    border-radius: 999px;
    font-family: var(--font-sub);
    font-size: 0.875rem;
  }

  .trasf__fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .trasf__foto {
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border-radius: var(--radio);
  }

  .trasf__foto :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
  }

  .trasf__foto--b {
    margin-top: 3rem;
    border-radius: 999px 999px var(--radio) var(--radio);
  }

  @media (max-width: 860px) {
    .trasf__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
